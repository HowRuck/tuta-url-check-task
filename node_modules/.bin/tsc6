#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/evogel/Downloads/tuta-url-check-task/node_modules/.pnpm/@typescript+typescript6@6.0.1/node_modules/@typescript/typescript6/node_modules:/home/evogel/Downloads/tuta-url-check-task/node_modules/.pnpm/@typescript+typescript6@6.0.1/node_modules:/home/evogel/Downloads/tuta-url-check-task/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/evogel/Downloads/tuta-url-check-task/node_modules/.pnpm/@typescript+typescript6@6.0.1/node_modules/@typescript/typescript6/node_modules:/home/evogel/Downloads/tuta-url-check-task/node_modules/.pnpm/@typescript+typescript6@6.0.1/node_modules:/home/evogel/Downloads/tuta-url-check-task/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../typescript/bin/tsc6" "$@"
else
  exec node  "$basedir/../typescript/bin/tsc6" "$@"
fi
